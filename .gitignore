# Python figure-generator cache
__pycache__/
*.pyc

# Тимчасові файли операцій для scripts/manifest-patch.js (фаза «Маніфест» батчу)
/scripts/_mfops-*.json

# Згенерований пошуковий індекс — будується в CI (.github/workflows/deploy.yml).
# Локально: `node scripts/build-search-index.js`, щоб протестувати пошук.
/search-index.json
/search-fulltext.json

# генерований зріз канону для агентів-письменників (робить scripts/make-writer-canon.js на старті батчу)
AUTHORING.write.en.md

# службові теки правки фігур і кеш Python
scripts/_svgfix/
scripts/__pycache__/

# Робоча тека конвеєрів: списки батчів, черги нових тем, payload-и на доробку, вироки суддів,
# разові скрипти під конкретний прогін. Усе це — стан ПРОЦЕСУ, а не вміст книг: переживає коло
# на диску, але у версіонуванні не має сенсу (регенерується наступним батчем).
/scripts/_finish/

# Службові звіти агентів у теках тем (пише конвеєр, читає людина один раз і забуває)
report.json
audit-report.json
audit_report.json

# Чернетки й разові дампи в корені (робочий стіл, а не репозиторій)
/claims_*.txt
/items_dump.txt
/scratch_*.txt
/record_verdicts.js
/scratch/

# Фігури, згенеровані з неправильної теки. figs.py пише у ВІДНОСНИЙ img/, тож запуск
# із кореня репо кладе .svg сюди замість теки своєї теми. Справжнє місце — <тека теми>/img/.
/img/

# Разові дампи перевірок і проби
/14_*.txt
/temp_items.txt
/test.svg

# Дампи виводу гейта, які агенти лишають у корені під час прогону
/gate_*.txt
/final_gate*.txt
/*_gate.txt
