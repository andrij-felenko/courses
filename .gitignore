# Python figure-generator cache
__pycache__/
*.pyc

# Тимчасові файли операцій для scripts/manifest-patch.js (фаза «Маніфест» батчу)
/scripts/_mfops-*.json

# Згенерований пошуковий індекс — будується в CI (.github/workflows/deploy.yml).
# Локально: `node scripts/build-search-index.js`, щоб протестувати пошук.
/search-index.json
/search-fulltext.json

# генерований зріз канону для агентів-письменників (робить scripts/make-writer-canon.js на старті батчу)
AUTHORING.write.en.md

# службові теки правки фігур і кеш Python
scripts/_svgfix/
scripts/__pycache__/

# Робоча тека конвеєрів: списки батчів, черги нових тем, payload-и на доробку, вироки суддів,
# разові скрипти під конкретний прогін. Усе це — стан ПРОЦЕСУ, а не вміст книг: переживає коло
# на диску, але у версіонуванні не має сенсу (регенерується наступним батчем).
/scripts/_finish/

# Службові звіти агентів у теках тем (пише конвеєр, читає людина один раз і забуває)
report.json
audit-report.json
audit_report.json

# Чернетки й разові дампи в корені (робочий стіл, а не репозиторій)
/claims_*.txt
/items_dump.txt
/scratch_*.txt
/record_verdicts.js
/scratch/

# Фігури, згенеровані з неправильної теки. figs.py пише у ВІДНОСНИЙ img/, тож запуск
# із кореня репо кладе .svg сюди замість теки своєї теми. Справжнє місце — <тека теми>/img/.
/img/

# Разові дампи перевірок і проби
/14_*.txt
/temp_items.txt
/test.svg

# Дампи виводу гейта, які агенти лишають у корені під час прогону
/gate_*.txt
/final_gate*.txt
/*_gate.txt

# Чернетки агентів у корені: дампи виводу, разові раннери, проби перевірок
/out.txt
/checks_out.txt
/runner.js
/scratch_*
/test_*.txt
/*.log
/scripts/*_out.txt

# У корені репо фігур не буває — кожна лежить у <тека теми>/img/.
# Файл тут означає, що figs.py запустили не з тієї теки (див. правило /img/ вище).
/*.svg
/temp_*
# разові скрипти агентів у scripts/ (справжні інструменти мають осмислені імена)
/scripts/temp_*.js
/scripts/check_verdicts.js
/scripts/fix_all_verdicts.js
# вивід перевірок, зронений у корінь замість екрана (svgcheck --json, звіти агентів)
/svgcheck_out.txt
/svg_res.txt
/*_out.txt
/*_res.txt
grep.exe.stackdump

# ── корінь репо — не смітник ────────────────────────────────────────────────
# Вивід гейтів і перевірок, разові скрипти агентів, чернетки. Місце для такого —
# scripts/_finish/ (уже в ігнорі). 2026-08-16 у корені лежало 51: gate_out2.txt,
# scratch_gate_live.js, шматок kernel/smp.c, затягнутий для звірки фактів, і навіть
# Qt-проєкт q_v4.2.0.pro — при тому, що Qt за каноном поза корпусом назавжди.
/gate*.txt
/gate*.log
/*_out.txt
/*_out2.txt
/*_utf8.txt
/out.txt
/claims.txt
/check*.txt
/check*.log
# дампи виводу перевірок: 12-thread.js.txt, 15-claims.js.txt тощо
/[0-9][0-9]-*.txt
/scratch_*
/temp_*
/test_*.txt
/record_verdicts.js
/runner.js
/*.stackdump
# сирці, затягнуті для звірки фактів, і чужі проєкти — у корпусі їм не місце
/*.c
/*.h
/*.pro
/*.qrc
15-claims.js.txt
12-thread.js.txt
