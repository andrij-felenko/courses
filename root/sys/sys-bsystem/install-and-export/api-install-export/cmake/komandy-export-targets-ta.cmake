# Експорт списку конкретних цілей
export(TARGETS <target>...
       [NAMESPACE <namespace::>]
       [APPEND]
       FILE <filename.cmake>
       [EXPORT_LINK_INTERFACE_LIBRARIES]
       [CXX_MODULES_DIRECTORY <directory>]
)

# Експорт за назвою експортного набору
export(EXPORT <export-name>
       [NAMESPACE <namespace::>]
       [FILE <filename.cmake>]
       [CXX_MODULES_DIRECTORY <directory>]
)
