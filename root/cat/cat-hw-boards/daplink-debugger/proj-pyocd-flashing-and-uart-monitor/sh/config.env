# ==============================================================================
# Конфігураційний файл параметрів для прошивки та моніторингу (config.env)
# ==============================================================================

# Модель цільового мікроконтролера для pyOCD (наприклад: stm32f411ce, stm32f103c8)
TARGET_MCU="stm32f411ce"

# Частота шини SWD у Герцах (за замовчуванням 4 МГц)
SWD_FREQUENCY="4000000"

# Шлях до файла прошивки (.bin або .hex)
FIRMWARE_PATH="build/firmware.bin"

# Послідовний порт UART зневаджувача WeAct Mini Debugger (DAPLink / ST-Link)
PORT="/dev/ttyACM0"

# Швидкість передачі даних UART (бод)
BAUD_RATE="115200"

# CLI-термінал для UART моніторингу (підтримуються: picocom, minicom, screen)
SERIAL_TERMINAL="picocom"
